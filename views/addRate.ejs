<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <title>Rental Facility App</title>
    </head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
          <a class="navbar-brand" href="/">Rental Facility App</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="collapsibleNavbar">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="/addRate">Add new rate</a>
              </li> 
            </ul>
          </div>
        </div>
    </nav>

    <div class="container">
        <br>
        <div class="text-center"><h2>Add New Rate</h2></div>
        <br>
        <div class="text-center">
            <form action="/addRate" method="POST" enctype="multipart/form-data">
                <label for="name">Facility:</label><br>
                <input type="text" id="name" name="facility" required><br><br>

                <label for="availability">Availability:</label><br>
                <input type="checkbox" id="availability" name="availability" ><br><br>

                <label for="price">Price/hr:</label><br>
                <input type="number" id="price_per_hour" name="price_per_hour" min="0" step="0.01" required><br><br>

                <!-- <label for="image">Image:</label><br>
                <input type="text" id="image" name="image" required><br><br> -->

                <label for="image">Image:</label><br>
                <input type="file" id="image" name="image" accept="image/*" required><br><br>

                <button type="submit">Add Rate</button>
            </form>
        </div>
    </div>
</body>
</html>
