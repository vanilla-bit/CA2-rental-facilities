<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Facility</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            background-image: url('/images/background.jpg');
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            min-height: 100vh;
            font-family: 'Poppins', sans-serif;
            color: white;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }

        .booking-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
        }

        .booking-form {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            font-weight: 500;
            margin-bottom: 8px;
            display: block;
            color: #fff;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            padding: 12px;
            height: auto;
            border-radius: 8px;
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.3);
            color: white;
            box-shadow: 0 0 0 0.25rem rgba(255, 255, 255, 0.1);
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        select.form-control option {
            background: #2c3e50;
            color: white;
        }

        .btn-submit {
            background: linear-gradient(45deg, #2193b0, #6dd5ed);
            border: none;
            width: 100%;
            padding: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        .alert {
            background: rgba(220, 53, 69, 0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(220, 53, 69, 0.3);
            color: white;
        }

        .booking-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .booking-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .input-group {
            position: relative;
        }

        .input-group i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.6);
        }

        @media (max-width: 768px) {
            .booking-container {
                margin: 20px;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="booking-container">
        <div class="booking-header">
            <h1><i class="fas fa-calendar-check"></i> Book Facility</h1>
        </div>

        <% if (messages && messages.length > 0) { %>
            <div class="alert alert-danger">
                <% messages.forEach(message => { %>
                    <p><i class="fas fa-exclamation-circle"></i> <%= message %></p>
                <% }); %>
            </div>
        <% } %>

        <form action="/process-booking" method="POST" class="booking-form">
            <input type="hidden" name="user_id" value="<%= user ? user.id : '' %>">
            <input type="hidden" name="rate_id" id="rate_id">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="username"><i class="fas fa-user"></i> Name</label>
                        <input type="text" class="form-control" id="username" name="username" 
                            value="<%= user ? user.username : formData.username || '' %>" 
                            <%= user ? 'readonly' : '' %> required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="email"><i class="fas fa-envelope"></i> Email</label>
                        <input type="email" class="form-control" id="email" name="email" 
                            value="<%= user ? user.email : formData.email || '' %>"
                            <%= user ? 'readonly' : '' %> required>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="contact"><i class="fas fa-phone"></i> Contact Number</label>
                        <input type="tel" class="form-control" id="contact" name="contact" 
                            value="<%= user ? user.contact : formData.contact || '' %>"
                            pattern="[0-9]{8}" title="Please enter 8 digits" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="facilities"><i class="fas fa-building"></i> Facility</label>
                        <select class="form-control" id="facilities" name="facilities" required>
                            <option value="">Select a facility</option>
                            <% if (typeof facilities !== 'undefined' && facilities.length > 0) { %>
                                <% facilities.forEach(facility => { %>
                                    <option value="<%= facility.facilityId %>" 
                                        <%= (selectedFacility && selectedFacility.facilityId === facility.facilityId) ? 'selected' : '' %>>
                                        <%= facility.name %>
                                    </option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="booking_date"><i class="fas fa-calendar"></i> Date</label>
                        <input type="date" class="form-control" id="booking_date" name="booking_date" 
                            min="<%= new Date().toISOString().split('T')[0] %>" required>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="start_time"><i class="fas fa-clock"></i> Start Time</label>
                        <input type="time" class="form-control" id="start_time" name="start_time" required>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="end_time"><i class="fas fa-clock"></i> End Time</label>
                        <input type="time" class="form-control" id="end_time" name="end_time" required>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="num_people"><i class="fas fa-users"></i> Number of People</label>
                        <input type="number" class="form-control" id="num_people" name="num_people" 
                            min="1" max="20" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="total_cost"><i class="fas fa-dollar-sign"></i> Total Cost</label>
                        <input type="number" class="form-control" id="total_cost" name="total_cost" 
                            readonly required>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/mybookings" class="btn btn-primary">
                Confirm Booking
                </a>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
document.addEventListener('DOMContentLoaded', function() {
    const facilitySelect = document.getElementById('facilities');
    const dateInput = document.getElementById('booking_date');
    const startTimeInput = document.getElementById('start_time');
    const endTimeInput = document.getElementById('end_time');
    const totalCostInput = document.getElementById('total_cost');
    const rateIdInput = document.getElementById('rate_id');

    async function calculateCost() {
        const facilityId = facilitySelect.value;
        const date = dateInput.value;
        const startTime = startTimeInput.value;
        const endTime = endTimeInput.value;

        if (!facilityId || !date || !startTime || !endTime) return;

        try {
            const response = await fetch('/api/calculate-rate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    facilityId,
                    date,
                    startTime,
                    endTime
                })
            });

            const data = await response.json();
            if (data.success) {
                totalCostInput.value = data.totalCost;
                rateIdInput.value = data.rateId;
            }
        } catch (error) {
            console.error('Error calculating rate:', error);
        }
    }

    // Add event listeners for form fields
    facilitySelect.addEventListener('change', calculateCost);
    dateInput.addEventListener('change', calculateCost);
    startTimeInput.addEventListener('change', calculateCost);
    endTimeInput.addEventListener('change', calculateCost);
});
</script>
</body>
</html>

