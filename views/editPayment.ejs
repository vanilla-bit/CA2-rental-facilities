<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Rental Facilities App</title>
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Rental Facilities App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" href="/editPayment">Edit Payment</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/logout">Logout</a>
            </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <h2 class="text-center mb-4">Edit Payment</h2>
    
    <% if (payment) { %>
      <form action="/editPayment/<%= payment.payment_id %>" method="POST" enctype="multipart/form-data" class="mx-auto" style="max-width: 500px;">
        <div class=" ">
          <label for="payment_date" class="form-label">Payment Date</label>
          <input type="date" class="form-control" id="payment_date" name="payment_date" required>
        </div>

        <div class=" ">
            <label for="payment_mode" class="form-label">Payment Mode</label>
            <label class="radio-inline">
                <input type="radio" name="payment_mode" checked>Cash 
            </label>
            <label class="radio-inline">
                <input type="radio" name="payment_mode">Check
            </label>
            <label class="radio-inline">
                <input type="radio" name="payment_mode">Credit/Debit Card
            </label>
        </div>

        <div class=" ">
          <label for="payment_status" class="form-label">Payment Status</label>
            <label class="radio-inline">
                <input type="radio" name="payment_status" checked>Paid 
            </label>
            <label class="radio-inline">
                <input type="radio" name="payment_status">Unpaid
            </label>
        </div>

        <div class=" ">
          <button type="submit" class="btn btn-primary">Update Payment</button>
          <a href="/" class="btn btn-secondary">Back to ...</a>
        </div>
      </form>
    <% } else { %>
      <p class="text-center">Payment not found.</p>
    <% } %>
  </div>
</body>
</html>