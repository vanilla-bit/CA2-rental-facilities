<!DOCTYPE html>
<html>
<head>
    <title>Edit Bookings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="/numofpeople.js" defer></script>

    <style>
        body {
            margin: 0;
            padding: 0;
            background-image: url('/images/background.jpg');
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            color: white;
            position: relative;
            z-index: 0;
        }

        /* Dark overlay on background */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5); /* adjust darkness */
            z-index: -1;
        }

        .booking-form {
            background-color: rgba(0, 0, 0, 0.6); /* translucent dark background */
            padding: 30px;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Facility Booking System</a>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="booking-form">
                    <h2 class="text-center mb-4">edit a Booking</h2>

                    <% if (messages && messages.length > 0) { %>
                        <div class="alert alert-danger">
                            <% messages.forEach(function(message) { %>
                                <p class="mb-0"><%= message %></p>
                            <% }); %>
                        </div>
                    <% } %>

                    <form action="/editBooking" method="POST">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="username" class="form-label">Username</label>
                                    <input type="text" id="username" name="username" class="form-control" required 
                                    value="<%= formData && formData.username ? formData.username : '' %>">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="email" class="form-label">Email</label>
                                    <input type="email" id="email" name="email" class="form-control" required 
                                    value="<%= formData && formData.email ? formData.email : '' %>">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="contact" class="form-label">Contact Number</label>
                                    <input type="text" id="contact" name="contact" class="form-control" required 
                                    value="<%= formData && formData.contact ? formData.contact : '' %>">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="facilities" class="form-label">Facilities</label>
                                    <select id="facilities" name="facilities" class="form-select" required>
                                        <option value="">Select a facility</option>
                                        <option value="basketball" <%= formData && formData.facilities === 'basketball' ? 'selected' : '' %>>Basketball Court</option>
                                        <option value="tennis" <%= formData && formData.facilities === 'tennis' ? 'selected' : '' %>>Tennis Court</option>
                                        <option value="gym" <%= formData && formData.facilities === 'gym' ? 'selected' : '' %>>Gym</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="booking_date" class="form-label">Booking Date</label>
                                    <input type="date" id="booking_date" name="booking_date" class="form-control" required
                                    value="<%= formData && formData.booking_date ? formData.booking_date : '' %>">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="start_time" class="form-label">Start Time</label>
                                    <input type="time" id="start_time" name="start_time" class="form-control" required
                                    value="<%= formData && formData.start_time ? formData.start_time : '' %>">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="end_time" class="form-label">End Time</label>
                                    <input type="time" id="end_time" name="end_time" class="form-control" required
                                    value="<%= formData && formData.end_time ? formData.end_time : '' %>">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="num_people" class="form-label">Number of People</label>
                                    <input type="number" id="num_people" name="num_people" min="1" class="form-control" required
                                    value="<%= formData && formData.num_people ? formData.num_people : '1' %>">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="total_cost" class="form-label">Total Cost ($)</label>
                                    <input type="text" id="total_cost" name="total_cost" class="form-control" readonly
                                    value="<%= formData && formData.total_cost ? formData.total_cost : '0' %>">
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-5">Book Now</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
