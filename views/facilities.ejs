<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Facility List App</title>
</head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">Facility List App</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/addFacility">Add new facility</a>
            </li> 
          </ul>
        </div>
      </div>
    </nav>
    <div class="text-end mb-3">
      <button type="button" class="btn btn-outline-dark" id="toggleBtn" onclick="toggleView()">Switch View</button>
    </div>

  <div class="container">
    <br>
    <div class="text-center"><h2>Facilities from Database</h2></div>
    <br>
    
    <div class="container mt-3">
    <form action="/facility/search" method="GET" class="d-flex justify-content-center" onsubmit="setViewMode()">
      <input type="text" name="query" class="form-control w-50 me-2" placeholder="Search facilities..." value="<%= typeof query !== 'undefined' ? query : '' %>">
      <input type="hidden" name="view" id="viewInput">
      <button type="submit" class="btn btn-outline-primary">Search</button>
      <button type="button" class="btn btn-outline-secondary" onclick="clearSearch()">Clear</button>
    </form>
  </div>




    <div id="tableView" style="display:block;">
      <table class="table table-hover small text-center">
        <thead>
          <tr>
            <th width="100">Facility Name</th>
            <th width="100">Facility Image</th>
            <th width="50">Description</th>
            <th width="50">Booking</th>
            <th width="50">Edit</th>
            <th width="50">Delete</th>
          </tr>
        </thead>
        <tbody>
          
<% if (noResults) { %>
    <tr>
      <td colspan="5" class="text-center text-muted">No results found for "<%= query %>".</td>
    </tr>
  <% } else { %>

          <% for(let i=0; i < facility.length; i++) { %>
            <tr>
              <td>
                <a href="#" class="facility-link" 
                   data-facility-id="<%=facility[i].facilityId%>"
                   data-bs-toggle="modal" 
                   data-bs-target="#facilityModal">
                    <%= facility[i].name %>
                </a>
              </td>
              <td><img src="/facilityimages/<%=facility[i].image%>" width="30%"></td>
              <td><%= facility[i].description %></td>
              <td>
                <% if (user) { %>
                    <a href="/book/<%= facility[i].facilityId %>" class="btn btn-outline-success">Book</a>
                <% } else { %>
                    <a href="/login" class="btn btn-outline-secondary">Login to Book</a>
                <% } %>
              </td>
              <td><a href="/editFacility/<%=facility[i].facilityId%>" class="btn btn-outline-warning">Edit</a></td>
              <td><a href="/deleteFacility/<%=facility[i].facilityId%>" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this facility?')">Delete</a></td>
            </tr>
          <% } %>
          <% } %>
        </tbody>
      </table>
    </div>

    <div id="cardView" style="display:none;"> 
      <div class="row">
        
<% if (noResults) { %>
    <div class="col-12 text-center text-muted">
      <p>No results found for "<%= query %>".</p>
    </div>
  <% } else { %>

        <% for(let i=0; i < facility.length; i++) { %>
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <img src ="/images/<%=facility[i].image%>" class="card-img-top">
              <div class="card-body">
                <h5 class="card-title"><a href="/facility/<%=facility[i].facilityId%>" class="btn btn-outline-primary"><%= facility[i].name %></a></h5>
                <p class="card-body"><%= facility[i].description %></p>
                <a href="/bookings" class="btn btn-outline-success">Book</a> <br><br>
                <div class="d-flex gap-3">
                <a href="/editFacility/<%=facility[i].facilityId%>" class="btn btn-outline-warning">Edit</a>
                <a href="/deleteFacility/<%=facility[i].facilityId%>" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this facility?')">Delete</a>
                </div>
              </div>
            </div>
          </div>
        <% } %>
        <% } %>
      </div>
    </div>
  </div>

<!-- Add this modal markup at the end of your body tag -->
<div class="modal fade" id="facilityModal" tabindex="-1" aria-labelledby="facilityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="facilityModalLabel">Facility Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <img id="modalFacilityImage" src="" alt="Facility Image" class="img-fluid mb-3">
                    </div>
                    <div class="col-md-6">
                        <h3 id="modalFacilityName"></h3>
                        <p id="modalFacilityDescription"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div id="modalBookingButton">
                    <!-- Booking button will be inserted here -->
                </div>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
  let isTableView = true;

  function toggleView() {
    const table = document.getElementById('tableView');
    const cards = document.getElementById('cardView');
    const button = document.getElementById('toggleBtn');

    if (isTableView) {
      table.style.display = 'none';
      cards.style.display = 'block';
      button.textContent = 'Switch to Table View';
    } else {
      table.style.display = 'block';
      cards.style.display = 'none';
      button.textContent = 'Switch to Card View';
    }

    isTableView = !isTableView;
  }
  
function setViewMode() {
      const viewInput = document.getElementById('viewInput');
      viewInput.value = isTableView ? 'table' : 'card';
    }

    window.onload = function () {
      const urlParams = new URLSearchParams(window.location.search);
      const view = urlParams.get('view');
      if (view === 'card') {
        toggleView(); // Switch to card view on load
      }
    };


function clearSearch() {
  document.querySelector('form').reset();

  // Preserve current view mode
  const viewMode = isTableView ? 'table' : 'card';
  window.location.href = `/facility?view=${viewMode}`;
}

document.addEventListener('DOMContentLoaded', function() {
    const facilityLinks = document.querySelectorAll('.facility-link');
    
    facilityLinks.forEach(link => {
        link.addEventListener('click', async function(e) {
            e.preventDefault();
            const facilityId = this.dataset.facilityId;
            
            try {
                const response = await fetch(`/facility/${facilityId}`);
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                const facility = await response.json();
                
                // Update modal content
                document.getElementById('modalFacilityName').textContent = facility.name;
                document.getElementById('modalFacilityDescription').textContent = facility.description;
                document.getElementById('modalFacilityImage').src = `/facilityimages/${facility.image}`;
                
                // Update booking button based on user authentication
                const bookingButton = document.getElementById('modalBookingButton');
                const isAuthenticated = "<%= user ? 'true' : 'false' %>";
                
                bookingButton.innerHTML = isAuthenticated 
                    ? `<a href="/book/${facility.facilityId}" class="btn btn-primary">Book Now</a>`
                    : `<a href="/login" class="btn btn-secondary">Login to Book</a>`;
                
            } catch (error) {
                console.error('Error:', error);
                alert('Error loading facility details');
            }
        });
    });
});
</script>

</body>
</html>
