<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <title>Facility List App</title>
</head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
          <a class="navbar-brand" href="/facility">Facility List App</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="collapsibleNavbar">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="/addFacility">Add new facility</a>
              </li> 
            </ul>
          </div>
        </div>
    </nav>
    
    <div class="container">
        <br>
        <div class="text-center"><h2>Facility Details</h2></div>
        <br>
        <% if (facility) { %> 
            <div>
                <p><b>Facility Name:</b><br> <%= facility.name %></p>
                <p><b>Facility Image:</b><br> <img src = "/facilityimages/<%=facility.image %>" width="35%"><br><br></p>
                <p><b>Description:</b><br> <%= facility.description %></p>
            </div>
        <% } else { %>
            <p>No facility found.</p>
        <% } %>
        <a href ="/facility">Back</a>
        <br><br>
        <% if (user) { %>
            <a href="/book/<%= facility.facilityId %>" class="btn btn-primary">Book Now</a>
        <% } else { %>
            <a href="/login" class="btn btn-secondary">Login to Book</a>
        <% } %>
    </div>
    
</body>
</html>
