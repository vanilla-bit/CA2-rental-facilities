<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h1>My Bookings</h1>
        
        <% if (bookings.length === 0) { %>
            <p>You have no bookings.</p>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Facility</th>
                            <th>Date</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Cost</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(booking => { %>
                            <tr>
                                <td><%= booking.facilityName %></td>
                                <td><%= new Date(booking.booking_date).toLocaleDateString() %></td>
                                <td><%= booking.start_time %></td>
                                <td><%= booking.end_time %></td>
                                <td>$<%= booking.total_cost.toFixed(2) %></td>
                                <td>
                                    <% const today = new Date();
                                    const bookingDate = new Date(booking.booking_date);
                                    if (bookingDate < today) { %>
                                        <span class="badge bg-secondary">Past</span>
                                    <% } else { %>
                                        <span class="badge bg-success">Upcoming</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (bookingDate >= today) { %>
                                        <form action="/bookings/cancel/<%= booking.bookingId %>" method="POST" style="display: inline;">
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to cancel this booking?')">
                                                Cancel
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
        
        <a href="/facilities" class="btn btn-primary">Book New Facility</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>