<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background-image: url('/images/background.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            color: white;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }

        .container {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 30px;
            margin-top: 40px;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }

        .page-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .page-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .table {
            color: white;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            overflow: hidden;
        }

        .table thead {
            background: rgba(255, 255, 255, 0.1);
        }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 1px;
            border-bottom: none;
        }

        .table td {
            vertical-align: middle;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .badge {
            padding: 8px 12px;
            font-weight: 500;
        }

        .badge.bg-success {
            background: linear-gradient(45deg, #28a745, #20c997) !important;
        }

        .badge.bg-secondary {
            background: linear-gradient(45deg, #6c757d, #495057) !important;
        }

        .btn-primary {
            background: linear-gradient(45deg, #2193b0, #6dd5ed);
            border: none;
            padding: 10px 20px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        .btn-danger {
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
            border: none;
            transition: all 0.3s ease;
        }

        .btn-danger:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(255,65,108,0.3);
        }

        .no-bookings {
            text-align: center;
            padding: 40px;
            color: rgba(255,255,255,0.8);
            font-size: 1.2rem;
        }

        @media (max-width: 768px) {
            .container {
                margin: 20px;
                padding: 20px;
            }
            
            .table {
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <div class="page-header">
            <h1><i class="fas fa-calendar-check"></i> My Bookings</h1>
        </div>
        
        <% if (bookings.length === 0) { %>
            <div class="no-bookings">
                <i class="fas fa-calendar-times fa-3x mb-3"></i>
                <p>You have no bookings yet.</p>
                <a href="/facilities" class="btn btn-primary">Book a Facility Now</a>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-building"></i> Facility</th>
                            <th><i class="fas fa-calendar"></i> Date</th>
                            <th><i class="fas fa-clock"></i> Start</th>
                            <th><i class="fas fa-clock"></i> End</th>
                            <th><i class="fas fa-dollar-sign"></i> Cost</th>
                            <th><i class="fas fa-info-circle"></i> Status</th>
                            <th><i class="fas fa-cog"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(booking => { %>
                            <tr>
                                <td><%= booking.facilityName %></td>
                                <td><%= new Date(booking.booking_date).toLocaleDateString() %></td>
                                <td><%= booking.start_time %></td>
                                <td><%= booking.end_time %></td>
                                <td>$<%= booking.total_cost.toFixed(2) %></td>
                                <td>
                                    <% const today = new Date();
                                    const bookingDate = new Date(booking.booking_date);
                                    if (bookingDate < today) { %>
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-history"></i> Past
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle"></i> Upcoming
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (bookingDate >= today) { %>
                                        <form action="/bookings/cancel/<%= booking.bookingId %>" method="POST" style="display: inline;">
                                            <button type="submit" class="btn btn-danger btn-sm" 
                                                onclick="return confirm('Are you sure you want to cancel this booking?')">
                                                <i class="fas fa-times"></i> Cancel
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            
            <div class="text-center mt-4">
                <a href="/facilities" class="btn btn-primary">
                    <i class="fas fa-plus-circle"></i> Book New Facility
                </a>
            </div>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>