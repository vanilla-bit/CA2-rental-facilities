<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Facility List App</title>
</head>

<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Rental Facilities App</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/payments">View Payments</a>
            </li> 
            <li class="nav-item">
                <a class="nav-link" href="/logout">Logout</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container">
    <div class="text-center"><h2>Your Payments</h2></div>
    <br>
    <table class="table table-hover small text-center">
      <thead>
          <tr>
            <th width="50">Payment Invoice Number</th>
            <th width="50">Month</th>
            <th width="50">Payment Amount</th>
            <th width="50">Payment Date</th>
            <th width="50">Payment Mode</th>
            <th width="50">Status</th>
          </tr>
      </thead>
      <tbody>
        <% for(let i=0; i < payments.length; i++) { %>
          <tr>
            <td><%= payments[i].payment_id %></td>
            <td><%= payments[i].month %></td>
            <td>
                $<%= payments[i].payment_amount.toFixed(2) %>
            </td>
            <td>
                <% let options = {year: "numeric", month: "short", day: "2-digit"} %>
                <%= payments[i].payment_date.toLocaleDateString("en-US", options)%>
            </td>
            <td><%= payments[i].payment_mode %></td>
            <td><%= payments[i].payment_status %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>

