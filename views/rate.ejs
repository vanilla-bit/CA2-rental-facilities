<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">Rental Facilities</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/locations">Locations</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/rooms">facility</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/classes">Classes</a>
            </li>

            <% if (typeof user !== 'undefined' && user) { %>
                <li class="nav-item">
                            <a class="nav-link" href="/bookings">Bookings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/billings">Billings</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link text-info" href="/user-dashboard">My Dashboard</a>
                        </li>
                    <% } %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" >
                                <%= user.username %>
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="/editProfile">
                                        <i class="bi bi-person-gear me-2"></i>Edit Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="/logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class ="nav-item"></li>
          </ul>
        </div>
      </div>
    </nav>
    
    <div class="container">
    <br>
    <div class="text-center"><h2>Rates from Rental Facility App Database</h2></div>
    <br>

    <div class="text-center">  
      <form action="/rate/search" method="get">
      <input type="text" name="query" value="<%= query %>" placeholder="Search facilityID, peak and non_peak hrs">
      <button type="submit" class="btn btn-outline-primary">Search</button>
        <button type="button" class="btn btn-outline-secondary" onclick="clearSearch()">Clear</button>
      </form>
    </div>
    
    <table class="table table-hover small text-center">
      <thead>
          <tr>
            <th width="100">Facility ID</th>
            <th width="100">Day</th>
            <th width="100">Peak</th>
            <th width="100">Price</th>
            <th width="50">Edit</th>
            <th width="50">Delete</th>
          </tr>
      </thead>
      <tbody>
        <% for(let i=0; i < rate.length; i++) { %>
          <tr>
            <td><%= rate[i].facility_id %></td>
            <td><%= rate[i].week %></td>
            <td><%= rate[i].peak %></td>
            <td>$<%= (rate[i].price != null) ? Number(rate[i].price).toFixed(2) : '0.00' %></td>
            <!--edit & delete links-->
            <td><a href="/editRate/<%= rate[i].rateId %>">Edit</a></td>
            <td><a href="/deleteRate/<%= rate[i].rateId %>" onclick="return confirm('Are you sure you want to delete this rate?')">Delete</a></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

<script>
function clearSearch() {
  document.querySelector('form').reset();
  window.location.href = '/rate';  // Redirect to default rate list page without query or view params
}
</script>
</body>
</html>
