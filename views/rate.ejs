<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
          <a class="navbar-brand" href="/">Rental facility App</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="collapsibleNavbar">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="/addRate">Add new rate</a>
              </li> 
            </ul>
          </div>
        </div>
    </nav>
    
    <div class="container">
    <br>
    <div class="text-center"><h2>Rates from Rental Facility App Database</h2></div>
    <br>
    <table class="table table-hover small text-center">
      <thead>
          <tr>
            <th width="100">Facility</th>
            <th width="100">Facility Image</th>
            <th width="50">Availability</th>
            <th width="50">Price/hr</th>
            <th width="50">Edit</th>
            <th width="50">Delete</th>
          </tr>
      </thead>
      <tbody>
        <% for(let i=0; i < rate.length; i++) { %>
          <tr>
            <td><a href="/rates/<%= rate[i].rateId %>"><%= rate[i].facility %></a></td>
            <td><img src="images/<%= rate[i].image %>" width="20%"></td>
            <td><%= rate[i].availability %></td>
            <td>$<%= (rate.price_per_hour != null) ? rate.price_per_hour.toFixed(2) : '0.00' %></td>
            <!--edit & delete links-->
            <td><a href="/editRate/<%= rate[i].rateId %>">Edit</a></td>
            <td><a href="/deleteRate/<%= rate[i].rateId %>" onclick="return confirm('Are you sure you want to delete this rate?')">Delete</a></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
