<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <title>Rental facility App</title>
</head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
          <a class="navbar-brand" href="/">Rental facility App</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="collapsibleNavbar">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="/addRate">Add new rate</a>
              </li> 
            </ul>
          </div>
        </div>
    </nav>
    
    <div class="container">
        <br>
        <div class="text-center"><h2>Rate Details</h2></div>
        <br>
        <% if (rate) { %> <!-- Check if rate data exists -->
            <div>
                <p><b>Facility:</b><br> <%= rate.facilityid %></p>
                <p><b>Day:</b><br> $<%= rate.week %></p>
                <p><b>Peak:</b><br> $<%= rate.peak %></p>
                <p><b>Price:</b><br> $<%= rate.price %></p>                
            </div>
        <% } else { %>
            <p>No Rate found.</p>
        <% } %>
        <a href ="/rate">Back</a>
    </div>
    
</body>
</html>