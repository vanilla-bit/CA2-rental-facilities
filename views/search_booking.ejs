<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Search Booking</title>
</head>
<body>
    <h1>Search Your Bookings</h1>

    <% if (messages && messages.length > 0) { %>
        <ul style="color: red;">
            <% messages.forEach(message => { %>
                <li><%= message %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/searchBookings" method="POST">
        <label for="search_term">Search by Facility or Booking Date:</label>
        <input type="text" id="search_term" name="search_term" placeholder="e.g. Gym or 2025-08-01" required>
        <button type="submit">Search</button>
    </form>

    <% if (bookings && bookings.length > 0) { %>
        <h2>Search Results:</h2>
        <table border="1">
            <tr>
                <th>ID</th>
                <th>Facility</th>
                <th>Date</th>
                <th>Time</th>
                <th>People</th>
                <th>Total Cost</th>
            </tr>
            <% bookings.forEach(booking => { %>
                <tr>
                    <td><%= booking.id %></td>
                    <td><%= booking.facilities %></td>
                    <td><%= booking.booking_date.toISOString().slice(0, 10) %></td>
                    <td><%= booking.start_time %> - <%= booking.end_time %></td>
                    <td><%= booking.num_people %></td>
                    <td>$<%= booking.total_cost.toFixed(2) %></td>
                </tr>
            <% }) %>
        </table>
    <% } else if (bookings) { %>
        <p>No bookings found for your search.</p>
    <% } %>
</body>
</html>
