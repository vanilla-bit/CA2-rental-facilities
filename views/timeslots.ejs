<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Supermarket App</title>
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Timeslot Manager</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="collapsibleNavbar">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" href="/addtimeslot">Add New Timeslot</a>
        </li> 
      </ul>
    </div>
  </div>
</nav>
  <div class="container">
    <br>
    <div class="text-center"><h2>Timeslots from Database</h2></div>
    <br>

    <table class="table table-hover small text-center">
      <thead>
        <tr>
          <th>Start Time</th>
          <th>End Time</th>
          <th>Created At</th>
          <th>Updated At</th>
          <th>Edit</th>
          <th>Delete</th>
        </tr>
      </thead>
      <tbody>
        <% for (let i = 0; i < timeslots.length; i++) { %>
          <tr>
            <td><%= timeslots[i].start_time %></td>
            <td><%= timeslots[i].end_time %></td>
            <td><%= new Date(timeslots[i].created_at).toLocaleString() %></td>
            <td><%= new Date(timeslots[i].updated_at).toLocaleString() %></td>
            <td><a href="/edittimeslot/<%= timeslots[i].timeslot_id %>">Edit</a></td>
            <td>
              <a href="/deletetimeslot/<%= timeslots[i].timeslot_id %>" onclick="return confirm('Are you sure you want to delete this timeslot?')">Delete</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>

